---
import { commandGroups } from "../lib/commands";
import { chordText } from "../lib/keys";
// A self-contained, theme-aware animation of Torrenta's command palette over its transfer list:
// a query types itself in, the list of commands filters, and the selection lands on the one that
// "runs". Pure CSS keyframes, no JS and no asset, so it stays crisp, recolours with the site theme
// and freezes on a tidy frame under prefers-reduced-motion. Editora's PaletteDemo with a torrent
// list behind it. The rows are real commands, looked up by id in the generated command data, so a
// title or chord that changes in the app changes here too.
const byId = new Map<string, (typeof commandGroups)[number]["commands"][number]>();
for (const g of commandGroups) for (const c of g.commands) byId.set(c.id, c);
const rows = [
  { id: "sequential", match: true },
  { id: "recheck", match: false },
  { id: "set-location", match: false },
  { id: "copy-magnet", match: false },
  { id: "limits", match: false },
].flatMap(({ id, match }) => {
  const c = byId.get(id);
  const chord = c?.keys[0];
  return c ? [{ title: c.title, chord: chord ? chordText(chord) : "", mac: chord ? chordText(chord, true) : "", match }] : [];
});
const palette = byId.get("palette")?.keys[0];

// The list behind the palette: the states the app colours, at the rates a busy evening has.
const torrents = [
  { name: "ubuntu-24.04.5-live-server-amd64.iso", state: "down", done: 49, rate: "13.4 MiB/s" },
  { name: "debian-13.7.0-amd64-netinst.iso", state: "up", done: 100, rate: "↑ 2.1 MiB/s" },
  { name: "archlinux-2026.10.01-x86_64.iso", state: "down", done: 95, rate: "5.1 MiB/s" },
  { name: "Sintel (2010) 4K", state: "done", done: 100, rate: "—" },
  { name: "fedora-workstation-43-x86_64.iso", state: "stall", done: 12, rate: "stalled" },
  { name: "big-buck-bunny-1080p.mkv", state: "up", done: 100, rate: "↑ 640 KiB/s" },
  { name: "openSUSE-Tumbleweed-DVD.iso", state: "down", done: 31, rate: "2.7 MiB/s" },
];
---

<div class="palette-demo" aria-hidden="true">
  <div class="pd-list-bg">
    {
      torrents.map((t) => (
        <div class={`pd-torrent st-${t.state}`}>
          <span class="pd-disc" />
          <span class="pd-name">{t.name}</span>
          <span class="pd-rate">{t.rate}</span>
          <span class="pd-bar">
            <span style={`width:${t.done}%`} />
          </span>
        </div>
      ))
    }
  </div>

  <div class="pd-palette">
    <div class="pd-input">
      {palette && <span class="pd-prompt" data-mac={chordText(palette, true)}>{chordText(palette)}</span>}
      <span class="pd-typed">sequ</span><span class="pd-caret"></span>
    </div>
    <ul class="pd-list">
      {
        rows.map((r, i) => (
          <li class={`pd-row${r.match ? " is-match" : ""}`} style={`--i:${i}`}>
            <span class="pd-title">{r.title}</span>
            {r.chord && <span class="pd-chord" data-mac={r.mac}>{r.chord}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .palette-demo {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    box-shadow:
      0 20px 50px -20px rgba(0, 0, 0, 0.6),
      0 0 0 1px var(--border-soft);
    font-family: var(--sans);
    user-select: none;
  }

  /* the transfer list the palette floats over */
  .pd-list-bg {
    position: absolute;
    inset: 0;
    padding: 0.6rem 0.9rem;
    display: flex;
    flex-direction: column;
    opacity: 0.5;
    font-size: clamp(0.62rem, 1.45vw, 0.85rem);
  }
  .pd-torrent {
    --st: var(--accent);
    display: grid;
    grid-template-columns: 1.1em 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0.7rem;
    row-gap: 0.25rem;
    align-items: center;
    padding: 0.45rem 0.2rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .pd-torrent.st-up {
    --st: var(--up);
  }
  .pd-torrent.st-done {
    --st: var(--done);
  }
  .pd-torrent.st-stall {
    --st: var(--warn);
  }
  .pd-disc {
    grid-row: span 2;
    width: 1.1em;
    height: 1.1em;
    border-radius: 50%;
    background: color-mix(in srgb, var(--st) 22%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--st) 55%, transparent);
  }
  .pd-name {
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pd-rate {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.9em;
  }
  .pd-bar {
    grid-column: 2 / 4;
    height: 3px;
    border-radius: 2px;
    background: var(--border-soft);
    overflow: hidden;
    max-width: 14rem;
  }
  .pd-bar span {
    display: block;
    height: 100%;
    background: var(--st);
  }

  /* the floating palette */
  .pd-palette {
    position: absolute;
    left: 50%;
    top: 8%;
    transform: translateX(-50%);
    width: min(85%, 30rem);
    background: color-mix(in srgb, var(--bg-soft) 92%, var(--bg));
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    animation: pd-pop 0.5s ease both;
  }

  .pd-input {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border-soft);
    font-size: clamp(0.72rem, 1.5vw, 0.9rem);
  }
  .pd-prompt {
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
    font-size: 0.78em;
    font-weight: 600;
  }
  .pd-typed {
    display: inline-block;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    vertical-align: bottom;
    width: 4ch; /* "sequ" is 4 chars */
    /* typewriter: reveal the query by animating width in char-steps —
       width-based reveal is bulletproof across browsers (unlike animating
       the `content` property). */
    animation: pd-type 8s steps(4, end) infinite;
  }
  .pd-caret {
    width: 2px;
    height: 1.05em;
    background: var(--accent);
    animation: pd-blink 1s steps(1) infinite;
  }

  .pd-list {
    list-style: none;
    margin: 0;
    padding: 0.3rem;
  }
  .pd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.42rem 0.6rem;
    border-radius: 7px;
    font-size: clamp(0.68rem, 1.4vw, 0.85rem);
    color: var(--muted);
    /* non-matching rows fade out once the query has narrowed the list */
    animation: pd-filter 8s ease infinite;
  }
  .pd-row.is-match {
    color: var(--text);
    /* the matching row keeps the selection highlight through the cycle */
    animation: pd-select 8s ease infinite;
  }
  .pd-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pd-chord {
    flex: none;
    color: var(--faint);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.02rem 0.4rem;
    font-size: 0.82em;
  }

  @keyframes pd-pop {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }
  @keyframes pd-blink {
    50% {
      opacity: 0;
    }
  }
  /* Reveal "sequ" one glyph at a time, hold, then backspace for the loop. */
  @keyframes pd-type {
    0% {
      width: 0;
    }
    14%,
    92% {
      width: 4ch;
    }
    100% {
      width: 0;
    }
  }

  /* Once the query is in (~24%), the non-matching rows collapse away. */
  @keyframes pd-filter {
    0%,
    22% {
      opacity: 1;
      max-height: 2.2rem;
      transform: none;
    }
    28%,
    90% {
      opacity: 0;
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      transform: translateY(-4px);
    }
    100% {
      opacity: 1;
      max-height: 2.2rem;
    }
  }
  /* The matching row slides to the top and lights up as the "run" moment. */
  @keyframes pd-select {
    0%,
    22% {
      background: transparent;
    }
    30%,
    82% {
      background: var(--accent-soft);
      box-shadow: inset 2px 0 0 var(--accent);
    }
    86% {
      background: var(--accent);
      box-shadow: none;
    }
    88%,
    100% {
      background: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pd-palette,
    .pd-typed,
    .pd-row,
    .pd-caret {
      animation: none !important;
    }
    .pd-typed {
      width: 4ch;
    }
    /* freeze on the filtered, selected frame */
    .pd-row:not(.is-match) {
      display: none;
    }
    .pd-row.is-match {
      background: var(--accent-soft);
      box-shadow: inset 2px 0 0 var(--accent);
      color: var(--text);
    }
  }
</style>
