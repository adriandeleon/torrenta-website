---
import { href } from "../lib/site";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { groupedFeatures } from "../lib/features";
import { version, repo } from "../lib/torrenta";
import { whatsNew } from "../lib/whatsnew";
import { commandGroups } from "../lib/commands";
import { chordText } from "../lib/keys";
import PaletteDemo from "../components/PaletteDemo.astro";
import PageToc from "../components/PageToc.astro";

const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base}/${p}`.replace(/\/{2,}/g, "/");
const logo = url("torrenta-icon.svg");

// Total registered commands, shown in the hero so the number stays accurate as commands.ts is
// regenerated.
const allCommands = commandGroups.flatMap((g) => g.commands);
const commandCount = allCommands.length;

// Thumbnail for a feature card: public/screenshots/features/<slug>.<ext> when there is one,
// WebP first (scripts/gen-images.mjs makes one beside every PNG).
const shotExts = ["webp", "png", "jpg", "jpeg", "avif", "svg"];
const featureShot = (id: string) => {
  const p = shotExts
    .map((e) => `screenshots/features/${id}.${e}`)
    .find((fp) => existsSync(resolve("public", fp)));
  return p ? url(p) : null;
};

// Latest entries for the home-page teaser, News and Blog interleaved by date. Same-day items
// tie-break on version (newest release first), then on the link.
const newsItems = (await getCollection("news")).map((e) => ({
  kind: "News",
  href: href(`/news/${e.id}`),
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  version: e.data.version,
  beta: e.data.beta,
}));
const blogItems = (await getCollection("blog")).map((e) => ({
  kind: "Blog",
  href: href(`/blog/${e.id}`),
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  version: undefined as string | undefined,
  beta: e.data.beta,
}));
const latest = [...newsItems, ...blogItems]
  .sort(
    (a, b) =>
      b.date.valueOf() - a.date.valueOf() ||
      (b.version ?? "").localeCompare(a.version ?? "", undefined, { numeric: true }) ||
      b.href.localeCompare(a.href),
  )
  .slice(0, 4);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

const featureGroups = await groupedFeatures();

// The keys a newcomer reaches for first, read from the generated command data.
const keyIds = [
  "palette",
  "filter",
  "add-magnet",
  "add-clipboard",
  "pause-resume",
  "create",
  "search",
  "rss",
  "limits",
  "set-category",
  "copy-magnet",
  "settings",
];
const keyRows = keyIds.flatMap((id) => {
  const c = allCommands.find((x) => x.id === id);
  return c && c.keys.length ? [{ title: c.title, pc: chordText(c.keys[0]), mac: chordText(c.keys[0], true) }] : [];
});

// Against the two clients Torrenta set out to replace, from the parity matrix in the app's
// docs/ROADMAP.md (Transmission 4.1, qBittorrent 5). Only rows Torrenta 0.3.0 really ships, plus the
// one it deliberately leaves for later, so the table never claims more than the release does.
type Mark = "yes" | "no" | "later";
const compare: { feature: string; t: Mark; tNote?: string; q: Mark; us: Mark }[] = [
  { feature: "A command palette over every action", t: "no", q: "no", us: "yes" },
  { feature: "Built-in search across providers, results merged", t: "no", q: "yes", us: "yes" },
  { feature: "RSS auto-download rules with episode filters", t: "no", q: "yes", us: "yes" },
  { feature: "Categories with their own save path, and tags", t: "no", q: "yes", us: "yes" },
  { feature: "Create torrents: v1, v2 or hybrid", t: "yes", q: "yes", us: "yes" },
  { feature: "Watch folders", t: "yes", q: "yes", us: "yes" },
  { feature: "IP filter from a blocklist URL, manual bans", t: "yes", q: "yes", us: "yes" },
  { feature: "Alternative speed limits on a weekly schedule", t: "yes", q: "yes", us: "yes" },
  { feature: "Offers the magnet or link on the clipboard", t: "no", q: "no", us: "yes" },
  { feature: "Downloads links to plain files too, beside the torrents", t: "no", q: "no", us: "yes" },
  { feature: "Drive a remote Transmission daemon", t: "yes", tNote: "remote GUI", q: "no", us: "yes" },
  { feature: "Settings synced between machines through Git", t: "no", q: "no", us: "yes" },
  { feature: "Saved filters as sidebar views, with live counts", t: "no", q: "no", us: "yes" },
  { feature: "Commands with arguments over every filtered torrent", t: "no", q: "no", us: "yes" },
  { feature: "Undo a remove, a move, a category or tags", t: "no", q: "no", us: "yes" },
  { feature: "Content check before adding: disguised programs, hidden extensions", t: "no", q: "no", us: "yes" },
  { feature: "Swarm preview before adding", t: "no", q: "no", us: "yes" },
  { feature: "Reuses files already on disk instead of downloading them", t: "no", q: "no", us: "yes" },
  { feature: "Imports torrents from qBittorrent, Transmission and Deluge", t: "no", q: "no", us: "yes" },
  { feature: "Play a file in a player while it downloads", t: "no", q: "no", us: "yes" },
  { feature: "Updatable torrents (BEP 46): follow and publish", t: "no", q: "no", us: "yes" },
  { feature: "Alternative limits on battery or a metered network", t: "no", q: "no", us: "yes" },
  { feature: "Leak check for a VPN binding", t: "no", q: "no", us: "yes" },
  { feature: "A web API for Sonarr, Radarr and phone apps", t: "yes", tNote: "its own RPC", q: "yes", us: "yes" },
  { feature: "Headless mode", t: "yes", q: "yes", us: "yes" },
  { feature: "Serves an alternative web UI from a folder", t: "yes", q: "yes", us: "yes" },
  { feature: "A web UI of its own", t: "yes", q: "yes", us: "later" },
];
const markText: Record<Mark, string> = { yes: "✓", no: "—", later: "later" };
const markLabel: Record<Mark, string> = { yes: "Yes", no: "No", later: "Planned after 1.0" };

const platforms = [
  { name: "macOS", note: "DMG, Apple Silicon (arm64)" },
  { name: "Windows", note: "MSI installer (x64)" },
  { name: "Linux", note: "DEB / RPM (x64)" },
];
---

<Layout>
  <PageToc />

  <section id="top" class="hero">
    <div class="hero-inner">
      <img class="hero-logo" src={logo} alt="Torrenta logo" width="96" height="96" />
      <h2 class="hero-name">Torrenta</h2>
      <h1 class="hero-title">Every torrent, one keystroke away</h1>
      <p class="tagline">
        A BitTorrent client for people who keep their hands on the keyboard. All
        {commandCount} commands are a chord or an <kbd data-mac="⌥X">Alt+X</kbd> search away,
        on libtorrent, the engine inside qBittorrent. Search, RSS rules and
        torrent creation built in. No account, no ads, no telemetry.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#download">Download</a>
        <a class="btn btn-ghost" href="#see-it">See the window</a>
      </div>

      <div class="badges">
        <a id="badge-stars" class="badge" href={`${repo}/stargazers`} hidden>
          <span class="badge-icon">★</span>
          <span id="badge-stars-count">—</span>
        </a>
        <a class="badge" href={`${repo}/blob/master/LICENSE`}>MIT License</a>
        <a id="badge-ci" class="badge" href={`${repo}/actions/workflows/ci.yml`} hidden>
          <span id="badge-ci-dot" class="badge-dot"></span>
          <span id="badge-ci-text">build</span>
        </a>
        <a class="badge" href={repo}>Open source on GitHub</a>
      </div>
    </div>

    <div class="hero-media">
      <PaletteDemo />
      <p class="hero-media-cap">
        The command palette over the transfer list. Every action is searchable, and every one has a key.
      </p>
    </div>
  </section>

  <main>
    <section id="see-it" class="section see-it">
      <h2>A look at the window</h2>
      <p class="section-lead">
        The real thing: the sidebar's status, category, tag and tracker filters,
        two-line rows with progress and peers, the omnibox above them, and the
        details pane explaining the selected download, its pieces, its speed and
        its facts. The status bar keeps the port, the DHT, the rates and the free
        space in view.
      </p>
      <figure class="demo-poster">
        <picture>
          <source srcset={url("screenshots/hero/transfers.webp")} type="image/webp" />
          <img
            src={url("screenshots/hero/transfers.png")}
            alt="Torrenta's main window: a sidebar of filters, five torrents downloading and seeding, and the details pane showing the selected torrent's pieces, a speed graph and its facts"
            width="1720"
            height="911"
            fetchpriority="high"
          />
        </picture>
        <figcaption>Torrenta {version} with the Editora&nbsp;Dark theme, on Linux.</figcaption>
      </figure>
    </section>

    <section id="why" class="section why">
      <h2>Why Torrenta</h2>
      <p class="section-lead">
        As complete as qBittorrent and Transmission, with the keyboard first and
        nothing in the way. Free, open source, and the same on macOS, Windows and
        Linux.
      </p>
      <div class="pillars">
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="6" width="20" height="12" rx="2" />
            <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8" />
          </svg>
          <h3>Keyboard-first</h3>
          <p>
            Every action has a chord and a palette entry and applies to the whole
            selection. The omnibox filters with <code>state:seeding</code>,
            <code>size&gt;4g</code> or <code>added&lt;7d</code>, runs a command after
            <code>&gt;</code>, and adds a magnet you paste into it.
          </p>
        </div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
          </svg>
          <h3>Nothing missing</h3>
          <p>
            Categories and tags, queue and share limits, scheduled speed limits,
            an IP filter, watch folders, run-on-event, RSS rules, search and
            torrent creation: what you would install qBittorrent for, in one
            window.
          </p>
        </div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <h3>Yours, quietly</h3>
          <p>
            No account, no ads, no telemetry. Beyond the swarm and the servers and
            feeds you add, the one request it makes is a daily look at GitHub for a
            newer release, which one setting turns off. Settings are a plain file
            you can read, edit and sync.
          </p>
        </div>
      </div>

      <h3 class="why-sub">One window, two engines</h3>
      <p class="why-sub-lead">
        Torrenta runs <a href="https://www.libtorrent.org">libtorrent</a> 2 in
        process, with v2 and hybrid torrents, uTP, DHT, PEX and encryption. Or it
        drives a <code>transmission-daemon</code> on a seedbox or a NAS over its
        RPC, from the same window: what the daemon cannot do is hidden, never
        greyed out or faked. <a href={href("/docs/remote")}>Read how</a>.
      </p>

      <p class="why-cta">
        <a class="btn btn-primary" href="#download">Download Torrenta</a>
        <span>Free and open source, for macOS, Windows and Linux. <a href="#compare">See how it compares</a>.</span>
      </p>
    </section>

    {
      latest.length > 0 && (
        <section id="latest" class="section">
          <div class="latest-head">
            <h2>From the blog &amp; news</h2>
            <span class="latest-links">
              <a href={href("/news")}>All news</a> · <a href={href("/blog")}>All posts</a>
            </span>
          </div>
          <div class="latest-grid">
            {latest.map((p) => (
              <a class="latest-card" href={p.href}>
                <span class="latest-tags">
                  <span class={`latest-kind kind-${p.kind.toLowerCase()}`}>{p.kind}</span>
                  {p.beta && <span class="beta-pill">Beta</span>}
                </span>
                <span class="latest-title">{p.title}</span>
                {p.description && <span class="latest-desc">{p.description}</span>}
                <span class="latest-date">{fmtDate(p.date)}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      whatsNew.length > 0 && (
        <section id="whats-new" class="section">
          <h2>What's new</h2>
          <p class="section-lead">
            The highlights of {version}. See{" "}
            <a href={`${repo}/blob/master/CHANGELOG.md`}>the changelog</a> for everything.
          </p>
          <ul class="news">
            {whatsNew.map((n) => (
              <li>
                <span class="news-title" set:html={n.title} />
                {n.detail && (
                  <span class="news-detail">
                    {": "}
                    <span set:html={n.detail} />
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="features" class="section">
      <h2>Features</h2>
      {
        featureGroups.map((g) => (
          <div class="feature-group">
            <h3 class="feature-group-title">{g.title}</h3>
            <div class="grid">
              {g.items.map((f) => {
                const shot = featureShot(f.id);
                return (
                  <a class="card" href={href(`/features/${f.id}`)}>
                    {shot ? (
                      <span class="card-shot">
                        <img src={shot} alt="" loading="lazy" decoding="async" width="560" height="315" />
                      </span>
                    ) : (
                      <span class="card-shot card-shot-empty" aria-hidden="true">
                        <svg viewBox="0 0 512 512" fill="none">
                          <path d="M146 302 L146 348 Q146 374 172 374 L340 374 Q366 374 366 348 L366 302" stroke="currentColor" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" />
                          <rect x="232" y="128" width="48" height="150" rx="14" fill="currentColor" />
                          <path d="M186 232 L256 304 L326 232" stroke="currentColor" stroke-width="46" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    )}
                    <h4>
                      {f.data.title}
                      {f.data.beta && <span class="beta-pill">Beta</span>}
                    </h4>
                    <p set:html={f.data.summary} />
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </section>

    <section id="compare" class="section">
      <h2>How it compares</h2>
      <p class="section-lead">
        Against Transmission 4.1 and qBittorrent 5, the two clients Torrenta set out
        to replace. The full matrix, row by row, is in the
        <a href={`${repo}/blob/master/docs/ROADMAP.md`}>roadmap</a>.
      </p>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Transmission</th>
              <th scope="col">qBittorrent</th>
              <th scope="col" class="us">Torrenta</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((r) => (
                <tr>
                  <td>{r.feature}</td>
                  <td>
                    <span class={`mark-${r.t}`} aria-label={markLabel[r.t]}>{markText[r.t]}</span>
                    {r.tNote && <span class="mark-note">{r.tNote}</span>}
                  </td>
                  <td>
                    <span class={`mark-${r.q}`} aria-label={markLabel[r.q]}>{markText[r.q]}</span>
                  </td>
                  <td class="us">
                    <span class={`mark-${r.us}`} aria-label={markLabel[r.us]}>{markText[r.us]}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="keys" class="section">
      <h2>Every action has a key</h2>
      <p class="section-lead">
        Chords are declared once, on the command, so the menus, the context menu,
        the toolbar and the palette can never disagree. A few to start with:
      </p>
      <ul class="keys">
        {
          keyRows.map((k) => (
            <li>
              <span>{k.title}</span>
              <kbd data-mac={k.mac}>{k.pc}</kbd>
            </li>
          ))
        }
      </ul>
      <p class="keys-more"><a href={href("/keybindings")}>All {commandCount} commands and their keys &rarr;</a></p>
    </section>

    <section id="download" class="section">
      <h2>Download</h2>
      <p class="section-lead">
        Native installers for macOS, Windows and Linux are attached to each release.
        Each bundles its own Java runtime and the engine; there is nothing else to
        install.
      </p>
      <div class="platforms">
        {
          platforms.map((p) => (
            <div class="platform">
              <strong>{p.name}</strong>
              <span>{p.note}</span>
            </div>
          ))
        }
      </div>
      <div class="cta">
        <span class="dl-split">
          <a id="dl-primary" class="btn btn-primary dl-main" href={`${repo}/releases/latest`} data-repo={repo}>
            Download
          </a>
          <button
            id="dl-toggle"
            class="btn btn-primary dl-caret"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Show downloads for all platforms"
            hidden
          >
            <span aria-hidden="true">▾</span>
          </button>
          <div id="dl-menu" class="dl-menu" role="menu" hidden></div>
        </span>
        <a class="btn btn-ghost" href={`${repo}/releases`}>All releases</a>
      </div>
      <p id="dl-sub" class="note">
        libtorrent's native library exists for these three platforms only, so
        Intel Macs and ARM Linux have no build yet.
      </p>
      <p class="note">
        Installers are currently unsigned. On macOS the first launch is blocked:
        open <em>System Settings → Privacy &amp; Security</em> and click
        <em>Open Anyway</em>. On Windows, if SmartScreen appears, choose
        <em>More info → Run anyway</em>. Each release lists SHA-256 checksums.
      </p>
    </section>

    <section id="quickstart" class="section">
      <h2>Build &amp; run from source</h2>
      <p class="section-lead">
        Requires JDK&nbsp;25 (the build refuses another and says so). A Maven
        wrapper is bundled, so no local Maven install is needed.
      </p>
      <div class="code-window">
        <div class="code-chrome">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="code-title">terminal</span>
        </div>
        <pre><code><span class="tok-comment"># Clone</span>
<span class="tok-keyword">git</span> clone {repo}.git
<span class="tok-keyword">cd</span> torrenta

<span class="tok-comment"># Run the app</span>
./mvnw javafx:run

<span class="tok-comment"># Tests, coverage floor and the formatter check</span>
./mvnw verify

<span class="tok-comment"># A self-contained app image (add -Dskip.installers=false for .deb .rpm | .dmg | .msi)</span>
./mvnw clean <span class="tok-flag">-Pdist</span> <span class="tok-flag">-DskipTests</span> package</code></pre>
      </div>
      <p class="note built-note">
        Built in the open with the help of AI coding tools. Every change lands as a
        reviewed, tested commit on GitHub.
      </p>
    </section>
  </main>

  <script is:inline define:vars={{ repo }}>
    (function () {
      var api = repo.replace("https://github.com/", "https://api.github.com/repos/");

      // --- OS-detected download ---
      (function () {
        var btn = document.getElementById("dl-primary");
        if (!btn) return;
        var ua = navigator.userAgent;
        var plat = navigator.platform || "";
        var os = "Linux",
          exts = [".deb", ".appimage", ".rpm", ".tar.gz"];
        if (/Mac/i.test(ua)) {
          os = "macOS";
          exts = [".dmg", ".pkg"];
        } else if (/Win/i.test(ua)) {
          os = "Windows";
          exts = [".msi", ".exe"];
        }
        btn.textContent = "Download for " + os;

        // Detect CPU arch. Browsers report "MacIntel"/"Intel" even on Apple
        // Silicon, so beyond the UA/platform string (which catches Linux/Windows
        // ARM) use userAgentData.architecture (Chromium) and a WebGL "Apple GPU"
        // renderer heuristic (works in Safari) to catch M-series Macs.
        function webglIsApple() {
          try {
            var c = document.createElement("canvas");
            var gl = c.getContext("webgl") || c.getContext("experimental-webgl");
            if (!gl) return false;
            var dbg = gl.getExtension("WEBGL_debug_renderer_info");
            var r = dbg ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) : "";
            return /apple/i.test(r) && !/intel|amd|radeon|nvidia/i.test(r);
          } catch (e) {
            return false;
          }
        }
        function detectArm(cb) {
          if (/aarch64|arm64|armv8|\barm\b/i.test(ua + " " + plat)) return cb(true);
          if (os === "Windows") return cb(false);
          var uad = navigator.userAgentData;
          if (uad && uad.getHighEntropyValues) {
            uad
              .getHighEntropyValues(["architecture"])
              .then(function (v) {
                cb(/arm|aarch/i.test(v.architecture || "") || webglIsApple());
              })
              .catch(function () {
                cb(webglIsApple());
              });
            return;
          }
          cb(webglIsApple());
        }

        detectArm(function (isArm) {
          // Never hand a visitor a package built for the other CPU. The one
          // cross-arch fallback is ARM macOS/Windows to x64, which both run
          // under emulation; Linux ARM cannot run an x64 .deb, and no x64
          // machine runs an arm64 build. With no match the button keeps its
          // link to the releases page.
          var archPrefs = isArm ? (os === "Linux" ? ["arm64"] : ["arm64", "x64"]) : ["x64"];
          // Try to deep-link the matching asset from the latest release.
          fetch(api + "/releases/latest")
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (rel) {
              if (!rel || !rel.assets) return;
              var pick = null;
              // Arch first, then the OS's package types in order of preference
              // (asset names end with e.g. "-linux-x64.deb"). So Linux ARM, which
              // ships no .deb, gets "-linux-arm64.tar.gz" rather than the x64
              // .deb. The "-native-experimental.tar.gz" archives never match:
              // the arch is not directly before their extension.
              for (var a = 0; a < archPrefs.length && !pick; a++) {
                for (var e = 0; e < exts.length && !pick; e++) {
                  for (var i = 0; i < rel.assets.length; i++) {
                    if (rel.assets[i].name.toLowerCase().endsWith("-" + archPrefs[a] + exts[e])) {
                      pick = rel.assets[i];
                      break;
                    }
                  }
                }
              }
              if (pick) {
                btn.href = pick.browser_download_url;
                var sub = document.getElementById("dl-sub");
                if (sub && rel.tag_name)
                  btn.textContent = "Download for " + os + " (" + rel.tag_name + ")";
              }
              buildMenu(rel);
            })
            .catch(function () {});
        });

        // --- Every build, one click away ---
        // Asset names look like "Torrenta-0.1.0-macos-arm64.dmg"; anything that
        // doesn't (checksums_sha256.txt) is skipped.
        function assetInfo(name) {
          var m = name.match(/-(macos|windows|linux)-(arm64|aarch64|x64|x86_64)\.(.+)$/i);
          if (!m) return null;
          var p = m[1].toLowerCase();
          var arm = /arm|aarch/i.test(m[2]);
          var label =
            p === "macos"
              ? arm
                ? "macOS (Apple Silicon)"
                : "macOS (Intel)"
              : p === "windows"
                ? arm
                  ? "Windows (ARM64)"
                  : "Windows (x64)"
                : arm
                  ? "Linux (ARM64)"
                  : "Linux (x64)";
          return {
            plat: p,
            arm: arm,
            ext: m[3],
            label: label,
            meta: "." + m[3] + " · " + (arm ? "aarch64" : "x86_64"),
          };
        }

        function rank(map, key, dflt) {
          var v = map[String(key).toLowerCase()];
          return v === undefined ? dflt : v;
        }

        function buildMenu(rel) {
          var menu = document.getElementById("dl-menu");
          var toggle = document.getElementById("dl-toggle");
          if (!menu || !toggle || !rel || !rel.assets) return;

          var items = [];
          for (var i = 0; i < rel.assets.length; i++) {
            var info = assetInfo(rel.assets[i].name);
            if (!info) continue;
            info.url = rel.assets[i].browser_download_url;
            items.push(info);
          }
          if (!items.length) return;

          // macOS, Windows, Linux; native installers before portable jars.
          var platRank = { macos: 0, windows: 1, linux: 2 };
          var extRank = { dmg: 0, msi: 0, exe: 0, deb: 1, rpm: 2, appimage: 3, "tar.gz": 4, jar: 5 };
          items.sort(function (a, b) {
            return (
              rank(platRank, a.plat, 9) - rank(platRank, b.plat, 9) ||
              // Apple Silicon first on macOS, x86 first elsewhere.
              (a.plat === "macos" ? (b.arm ? 1 : 0) - (a.arm ? 1 : 0) : (a.arm ? 1 : 0) - (b.arm ? 1 : 0)) ||
              rank(extRank, a.ext, 9) - rank(extRank, b.ext, 9) ||
              a.ext.localeCompare(b.ext)
            );
          });

          menu.textContent = "";
          items.forEach(function (it) {
            var a = document.createElement("a");
            a.className = "dl-item";
            a.href = it.url;
            a.setAttribute("role", "menuitem");
            var main = document.createElement("span");
            main.className = "dl-item-main";
            var name = document.createElement("span");
            name.className = "dl-item-name";
            name.textContent = it.label;
            var meta = document.createElement("span");
            meta.className = "dl-item-meta";
            meta.textContent = it.meta;
            main.appendChild(name);
            main.appendChild(meta);
            var arrow = document.createElement("span");
            arrow.className = "dl-item-arrow";
            arrow.setAttribute("aria-hidden", "true");
            arrow.textContent = "→";
            a.appendChild(main);
            a.appendChild(arrow);
            a.addEventListener("click", close);
            menu.appendChild(a);
          });
          toggle.hidden = false;

          function close() {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
          }
          toggle.addEventListener("click", function (e) {
            e.stopPropagation();
            if (menu.hidden) {
              menu.hidden = false;
              toggle.setAttribute("aria-expanded", "true");
            } else {
              close();
            }
          });
          document.addEventListener("click", function (e) {
            if (!menu.hidden && !menu.contains(e.target) && !toggle.contains(e.target)) close();
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !menu.hidden) {
              close();
              toggle.focus();
            }
          });
        }
      })();

      // --- GitHub stars ---
      fetch(api)
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || typeof d.stargazers_count !== "number") return;
          // Only surface the star count once it reads as social proof rather
          // than a liability; below the threshold the "Open source on GitHub"
          // badge already invites a star.
          if (d.stargazers_count < 25) return;
          var el = document.getElementById("badge-stars");
          document.getElementById("badge-stars-count").textContent =
            d.stargazers_count.toLocaleString();
          el.hidden = false;
        })
        .catch(function () {});

      // --- CI status (latest run on default branch) ---
      fetch(api + "/actions/workflows/ci.yml/runs?per_page=1")
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || !d.workflow_runs || !d.workflow_runs.length) return;
          var run = d.workflow_runs[0];
          var ok = run.conclusion === "success";
          var el = document.getElementById("badge-ci");
          document.getElementById("badge-ci-text").textContent = ok
            ? "build passing"
            : "build " + (run.conclusion || run.status || "unknown");
          document.getElementById("badge-ci-dot").style.background = ok
            ? "#3fb950"
            : "#d29922";
          el.hidden = false;
        })
        .catch(function () {});
    })();
  </script>
</Layout>

